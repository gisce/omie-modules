<?xml version="1.0" encoding="UTF-8" ?>
<openerp>
    <data>
        <menuitem name="OMIE" id="menu_omie"/>
        <!--OMIE OFERTA HORA-->
        <record model="ir.ui.view" id="giscedata_omie_oferta_hora_tree">
            <field name="name">giscedata.omie.oferta.hora.tree</field>
            <field name="model">giscedata.omie.oferta.hora</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Horas de Ofertas de OMIE">
                    <field name="per"/>
                    <field name="div"/>
                    <field name="ret"/>
                    <field name="ctn"/>
                    <field name="prc"/>
			    </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="giscedata_omie_oferta_hora_form">
            <field name="name">giscedata.omie.oferta.hora.form</field>
            <field name="model">giscedata.omie.oferta.hora</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Hora de Ofertas de OMIE">
                    <group colspan="8">
                        <field name="per" colspan="8" readonly="1"/>
                        <field name="ctn" colspan="8" readonly="1"/>
                        <field name="prc" colspan="8" readonly="1"/>
                        <field name="div" colspan="8" readonly="1"/>
                        <field name="ret" colspan="8" readonly="1"/>
                    </group>
                </form>
            </field>
        </record>
        <!--FIN OMIE OFERTA HORA-->
        <!--OMIE OFERTA-->
        <record model="ir.ui.view" id="giscedata_omie_oferta_tree">
            <field name="name">giscedata.omie.oferta.tree</field>
            <field name="model">giscedata.omie.oferta</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Ofertas de OMIE">
                    <field name="id_oferta"/>
                    <field name="fecha_sesion"/>
                    <field name="tipo_mercado"/>
                    <field name="id_unidad"/>
                    <field name="clase_oferta"/>
                    <field name="total_energia"/>
                    <field name="state"/>
                    <field name="valida"/>
                    <field name="sustituida"/>
                    <field name="origen"/>
                    <field name="id_mensaje"/>
                    <field name="ver_mensaje"/>
                    <field name="fecha_mensaje"/>
                    <field name="id_remitente"/>
                    <field name="cod_min_unidad"/>
                    <field name="tipo_unidad"/>
                    <field name="ind_defecto"/>
                    <field name="comentario_oferta"/>
                    <field name="hora_ids" nolabel="1"/>
			    </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="giscedata_omie_oferta_form">
            <field name="name">giscedata.omie.oferta.form</field>
            <field name="model">giscedata.omie.oferta</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Ofertas de OMIE">
                    <notebook>
                        <page string="Oferta">
                            <group col="10">
                                <group string="Mensaje" icon="message" col="10" colspan="10" attrs="{'readonly':[('state', 'in', ('enviada', 'enviada_error'))]}">
                                    <field name="id_mensaje" colspan="2"/>
                                    <field name="ver_mensaje" colspan="2"/>
                                    <field name="id_remitente" colspan="3"/>
                                    <field name="fecha_mensaje" colspan="3" attrs="{'invisible':[('state','=','no_enviada')]}"/>
                                </group>
                                <group string="Información Oferta" icon="file-info" col="10" colspan="5" attrs="{'readonly':[('state', 'in', ('enviada', 'enviada_error'))]}">
                                    <field name="id_oferta" colspan="2"/>
                                    <field name="ind_defecto" colspan="2"/>
                                    <field name="clase_oferta" colspan="3" select="1"/>
                                    <field name="total_energia" colspan="3"/>
                                    <field name="comentario_oferta" colspan="10"/>
                                </group>
                                <group string="Información Unidad" icon="info-circle" col="10" colspan="5" attrs="{'readonly':[('state', 'in', ('enviada', 'enviada_error'))]}">
                                    <field name="id_unidad" colspan="2" select="1"/>
                                    <field name="cod_min_unidad" colspan="8"/>
                                    <field name="area_unidad" colspan="4"/>
                                    <field name="tipo_unidad" colspan="6"/>
                                </group>
                                <group string="Validez" icon="calendar-check" col="10" colspan="10" attrs="{'readonly':[('state', 'in', ('enviada', 'enviada_error'))]}">
                                    <field name="tipo_mercado" colspan="5"/>
                                    <field name="fecha_sesion" colspan="5" select="1"/>
                                </group>
                            </group>
                            <group attrs="{'readonly':[('state', 'in', ('enviada', 'enviada_error'))]}">
                                <field name="state" colspan="2" select="1"/>
                                <field name="origen" colspan="4" select="1"/>
                                <button string="Enviar Oferta" name="enviar_oferta" type="object" primary="1" icon="send" colspan="4"/>
                                <field name="hora_ids" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Respuesta" attrs="{'invisible':[('state', 'not in', ('enviada', 'enviada_error'))]}">
                            <group col="10">
                                <group string="Mensaje" icon="message" col="3" colspan="3">
                                    <field name="id_mensaje_respuesta" colspan="3"/>
                                    <field name="fecha_mensaje_respuesta" colspan="3"/>
                                </group>
                                <group string="Remitente" icon="mail" col="3" colspan="2">
                                    <field name="id_remitente_respuesta" colspan="3"/>
                                    <field name="id_remitente_origen" colspan="3"/>
                                </group>
                                <group string="Resultado" icon="clipboard-text" col="4" colspan="2">
                                    <field name="num_ofertas_procesadas" colspan="2"/>
                                    <field name="sustituida" colspan="2" select="2"/>
                                    <field name="num_ofertas_correctas" colspan="2"/>
                                    <field name="valida" colspan="2" select="2"/>
                                </group>
                                <group string="Respuesta" icon="send" col="10" colspan="10">
                                    <field name="codigo_respuesta" colspan="10"/>
                                    <field name="texto_respuesta" colspan="10"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_listar_ofertas">
            <field name="name">Ofertas de OMIE</field>
            <field name="res_model">giscedata.omie.oferta</field>
            <field name="src_model">giscedata.omie.oferta</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem name="Ofertas de OMIE" id="listado_ofertas" action="action_listar_ofertas" parent="menu_omie"/>
        <!--FIN OMIE OFERTA-->
    </data>
</openerp>