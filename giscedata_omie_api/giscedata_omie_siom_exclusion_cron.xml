<?xml version="1.0" encoding="utf-8"?>
<openerp>
  <data noupdate="1">
    <!-- Habilitar SOLO tras configurar el certificado y el AppID del agente.
         No activa los bloqueos 8100: siom_8100_apply comienza en 0. -->
    <record id="cron_siom_actualizar_8100" model="ir.cron">
      <field name="name">OMIE SIOM - actualizar periodos 8100</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="active" eval="False"/>
      <field name="interval_number" eval="30"/>
      <field name="interval_type">minutes</field>
      <field name="numbercall" eval="-1"/>
      <field name="doall" eval="False"/>
      <field name="model">giscedata.omie.siom.exclusion.observation</field>
      <field name="function">cron_actualizar_8100</field>
      <field name="args" eval="'()'"/>
    </record>
  </data>
</openerp>
