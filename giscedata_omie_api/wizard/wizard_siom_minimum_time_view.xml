<?xml version="1.0" encoding="utf-8"?>
<openerp>
  <data>
    <record id="view_wizard_siom_minimum_time_update_form" model="ir.ui.view">
      <field name="name">wizard.siom.minimum.time.update.form</field>
      <field name="model">wizard.siom.minimum.time.update</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form string="Actualizar tiempos mínimos de OMIE (8101)">
          <field name="state" invisible="1"/>
          <group col="4" attrs="{'invisible': [('state', '!=', 'init')]}">
            <label string="Ejecuta la consulta 8101 de OMIE y actualiza los limites almacenados. Una respuesta sin filas NO borra los datos existentes." colspan="4"/>
            <group col="10">
              <label colspan="6"/>
              <button special="cancel" string="Cancelar" icon="gtk-cancel" colspan="2" danger="1"/>
              <button name="actualizar_desde_omie" type="object" string="Actualizar desde OMIE" icon="gtk-refresh"
                      colspan="2" primary="1"/>
            </group>
          </group>
          <group col="4" attrs="{'invisible': [('state', '!=', 'done')]}">
            <field name="info" colspan="4" readonly="1"/>
            <field name="recibidas" readonly="1"/>
            <field name="nuevas" readonly="1"/>
            <field name="actualizadas" readonly="1"/>
            <group col="10">
              <label colspan="8"/>
              <button special="cancel" string="Cerrar" icon="gtk-close" colspan="2" danger="1" primary="1"/>
            </group>
          </group>
        </form>
      </field>
    </record>

    <record id="action_wizard_siom_minimum_time_update" model="ir.actions.act_window">
      <field name="name">Actualizar tiempos minimos (8101)</field>
      <field name="res_model">wizard.siom.minimum.time.update</field>
      <field name="view_type">form</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_wizard_siom_minimum_time_update_form"/>
      <field name="target">new</field>
    </record>
    <menuitem id="menu_wizard_siom_minimum_time_update"
              name="Actualizar tiempos minimos desde OMIE"
              parent="menu_omie_siom_limits"
              action="action_wizard_siom_minimum_time_update"
              groups="group_giscedata_omie_oferta_u" sequence="15"/>
  </data>
</openerp>
