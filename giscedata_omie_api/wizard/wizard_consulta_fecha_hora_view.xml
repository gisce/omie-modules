<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
        <record id="view_wizard_consulta_fecha_hora_form" model="ir.ui.view">
            <field name="name">wizard.consulta.fecha.hora.form</field>
            <field name="model">wizard.consulta.fecha.hora</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Consultar Fecha y Hora Oficial del Mercado">
                    <field name="state" invisible="1"/>
                    <group col="10" attrs="{'invisible': [('state', '!=', 'init')]}">
                        <label string="Consultar la Fecha y Hora Oficial del Mercado en Tiempo Real." colspan="10"/>
                        <group col="10">
                            <label colspan="6"/>
                            <button icon="gtk-cancel" special="cancel" string="Cancelar" type="object"
                                    colspan="2" danger="1"/>
                            <button icon="gtk-ok" name="consulta_fecha_hora" string="Consultar Fecha y Hora"
                                    type="object" colspan="2" primary="1"/>
                        </group>
                    </group>
                    <group col="4" attrs="{'invisible': [('state', '!=', 'end')]}">
                        <field name="fecha_hora" colspan="4"/>
                        <group col="10">
                            <label colspan="8"/>
                            <button icon="gtk-cancel" special="cancel" string="Cerrar" type="object" danger="1"
                                    primary="1" colspan="2"/>
                        </group>
                    </group>
                    <group col="10" attrs="{'invisible': [('state', '!=', 'error')]}">
                        <label string="No se ha realizado correctamente la conexión con OMIE." colspan="10"/>
                        <label colspan="8"/>
                        <button icon="gtk-cancel" special="cancel" string="Cerrar" type="object" colspan="2"
                                primary="1" danger="1"/>
                    </group>
                </form>
            </field>
        </record>
        <record id="action_wizard_consulta_fecha_hora" model="ir.actions.act_window">
            <field name="name">Consultar Fecha y Hora Oficial del Mercado</field>
            <field name="res_model">wizard.consulta.fecha.hora</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_wizard_consulta_fecha_hora_form"/>
            <field name="target">new</field>
        </record>
        <record id="value_consulta_fecha_hora" model="ir.values">
            <field name="object" eval="1"/>
            <field name="name">Consultar Fecha y Hora Oficial del Mercado</field>
            <field name="key2">client_action_multi</field>
            <field name="key">action</field>
            <field name="value" eval="'ir.actions.act_window,'+str(ref('action_wizard_consulta_fecha_hora'))" />
        </record>
        <menuitem name="Consultar Fecha y Hora Oficial del Mercado" id="consulta_fecha_hora_mercado"
                  action="action_wizard_consulta_fecha_hora" parent="menu_omie" sequence="98"/>
    </data>
</openerp>